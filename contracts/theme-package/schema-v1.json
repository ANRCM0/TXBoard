{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:txboard:theme-package:v1",
  "title": "TXBoard Theme Package v1 config.json",
  "type": "object",
  "required": ["name", "version"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^/\\\\\\u0000]+$",
      "not": {
        "enum": [".", ".."]
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "txboard": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "configs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field_name"],
        "properties": {
          "field_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

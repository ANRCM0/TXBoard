# Public gateway listen address. Bind to localhost behind Caddy/Nginx.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Fixed TXBoard origin. Required. Use TLS in production.
TXBOARD_UPSTREAM_URL=https://your-txboard.example.com
# Set true ONLY for trusted internal HTTP origins, e.g. http://txboard:80 in a private Docker network.
TXBOARD_ALLOW_PRIVATE_HTTP=false

# Local/testing B5.2/B5.3. Exact true opts profile/detail/list into mTLS; no fallback.
GATEWAY_INTERNAL_USER_ENABLED=false
# Separate opt-in for public site/theme metadata and plans over the same local mTLS.
GATEWAY_INTERNAL_PUBLIC_READ_ENABLED=false
# Isolated local login only; Core also requires its own flag and isolated-copy marker.
GATEWAY_INTERNAL_LOGIN_ENABLED=false
# Separate encrypted email-only local fixture mode; never opens registration.
GATEWAY_INTERNAL_EMAIL_CODE_ENABLED=false
# Independent local/testing-only synthetic registration; requires Internal mTLS + HPKE + Redis.
GATEWAY_INTERNAL_REGISTER_ENABLED=false
# Independent local/testing-only password recovery; requires Internal mTLS + HPKE + Redis.
GATEWAY_INTERNAL_PASSWORD_RESET_ENABLED=false
GATEWAY_INTERNAL_SESSIONS_ENABLED=false
# APP_ENV=testing
# GATEWAY_INTERNAL_USER_CONFIG_FILE=/absolute/server-only/internal-user.json

# Comma-delimited exact frontend origins including scheme and port.
# No wildcards. Required if browser sends an Origin header.
GATEWAY_ALLOWED_ORIGINS=https://your-txboard.example.com

# Network controls
GATEWAY_UPSTREAM_TIMEOUT_MS=8000
GATEWAY_MAX_RESPONSE_BYTES=1048576
GATEWAY_MAX_REQUEST_BYTES=16384

# Docker-only deployment. Network must exist and be private to your proxy.
GATEWAY_DOCKER_NETWORK=txboard-gateway-private
GATEWAY_IMAGE=txboard-gateway:local

# Enable encryption only with compose.crypto.yaml, private Redis and persisted Docker JWK secret.
# See docs/docker-deployment.md. Redis-atomic replay preview is NOT production-approved.
GATEWAY_HPKE_SECRET_FILE=./secrets/gateway-hpke.json

# Required whenever GATEWAY_HPKE_MODE=optional. Redis must be private.
# GATEWAY_REDIS_URL=redis://gateway-redis:6379
# Opt-in: encrypted registration + email verification; defaults to off.
GATEWAY_ACCOUNT_WORKFLOWS_ENABLED=false

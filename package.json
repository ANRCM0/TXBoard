{
  "name": "txboard-monorepo",
  "private": true,
  "workspaces": [
    "web/shared",
    "web/admin",
    "web/user"
  ],
  "scripts": {
    "typecheck:web": "npm run typecheck --workspaces --if-present",
    "test:web": "npm run test --workspaces --if-present",
    "build:web": "npm run build --workspaces --if-present",
    "verify:web": "npm run typecheck:web && npm run test:web && npm run build:web"
  }
}

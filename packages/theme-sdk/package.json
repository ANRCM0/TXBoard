{
  "name": "@txboard/theme-sdk",
  "version": "0.1.0",
  "description": "TypeScript client for TXBoard Gateway v1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experimental/sc-v2-codec": {
      "types": "./dist/experimental/sc-v2-codec.d.ts",
      "import": "./dist/experimental/sc-v2-codec.js"
    },
    "./experimental/sc-v2-crypto": {
      "types": "./dist/experimental/sc-v2-crypto.d.ts",
      "import": "./dist/experimental/sc-v2-crypto.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@hpke/core": "1.9.0"
  }
}

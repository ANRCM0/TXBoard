# Anything listed here is absent from the build context, so it cannot be copied
# into the image. The entries under "local state" matter most: a developer's
# bootstrap/cache/config.php would bake a stale configuration into the image and
# silently override the container's own environment.

# ---- dependencies and build output ----
/node_modules
/vendor
/public/hot
/public/storage
/public/env.example.js
/composer.phar
/storage/*.key
/storage/*.conf
/storage/laravels.conf
/storage/laravels.pid
/storage/laravels-timer-process.pid
/config/v2board.php

# ---- local state that must never reach an image ----
/bootstrap/cache/*.php
/database/*.sqlite
/database/*.sqlite-journal
/storage/app/*
/storage/debugbar/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
*.log

# ---- credentials ----
.env
.env.backup
.env.*.local

# ---- not needed at runtime ----
# PHPUnit is a dev dependency and `composer install --no-dev` is used, so the
# suite and its config are dead weight in the image.
/tests
/phpunit.xml
/phpunit.xml.dist
/.phpunit.cache
/.phpunit.result.cache

# ---- editors and VCS ----
/.git
/.github
/.idea
/.vscode
.DS_Store
.lock
npm-debug.log
yarn-error.log
yarn.lock
Homestead.json
Homestead.yaml
docker-compose.yml
/docker
/frontend

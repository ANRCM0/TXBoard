# GW-216 Staging Environment Template
# Copy to repository root as .env, then adjust values. Never commit real secrets.

# Network / upstream (required)
TXBOARD_STAGING_NETWORK=txboard-staging_default
TXBOARD_STAGING_UPSTREAM_URL=http://txboard
TXBOARD_ALLOW_PRIVATE_HTTP=true

# Browser origin that may call the Gateway over HTTPS (required)
GATEWAY_STAGING_ALLOWED_ORIGINS=https://staging.example.test

# Image / runtime behavior
GATEWAY_IMAGE=txboard-gateway:staging
GATEWAY_UPSTREAM_TIMEOUT_MS=8000
GATEWAY_LOG_LEVEL=info

# Security: leave disabled until isolated CAPTCHA and rollback verification are done
GATEWAY_HPKE_MODE=disabled
GATEWAY_ACCOUNT_WORKFLOWS_ENABLED=false
GATEWAY_REDIS_URL=redis://gateway-redis:6379

# Existing generated HPKE key. For staging-only first-time generation:
# node scripts/generate-hpke-key.mjs
# sudo chown 1000:1000 secrets/gateway-hpke.json
# sudo chmod 600 secrets/gateway-hpke.json
GATEWAY_HPKE_SECRET_FILE=./secrets/gateway-hpke.json

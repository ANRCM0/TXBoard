VITE_PORT=3001
VITE_PROXY_TARGET=http://127.0.0.1:7801

# Public Passport API. Current Xboard: /api/v2/passport/*
VITE_API_V2_PUBLIC_PREFIX=/api/v2

# Admin API. The secure path is generated per instance, so TXBoard resolves it
# at runtime instead of baking it into the bundle: window.settings.secure_path
# when the bundle is served by Xboard, otherwise the value returned by an admin
# sign-in. Only set this to pin an explicit prefix (for example when developing
# against a fixed local instance).
# VITE_API_V2_ADMIN_PREFIX=/api/v2/your-secure-path

# Legacy compatibility; VITE_API_V2_ADMIN_PREFIX takes priority.
# VITE_API_V2_PREFIX=/api/v2/de47dcba

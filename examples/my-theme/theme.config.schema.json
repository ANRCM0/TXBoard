{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "my-theme 主题配置（外观候选字段，服务端为最终权威）",
  "additionalProperties": false,
  "properties": {
    "primaryColor": {
      "type": "string",
      "description": "主色，CSS 变量 --color-primary 的值（仅外观用途）",
      "default": "#0f766e",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    }
  }
}

APP_NAME=TXBoard
APP_ENV=production
# Intentionally empty. The container entrypoint generates one on first boot and
# persists it here (Docker); on bare metal run `php artisan key:generate`.
# Shipping a real key would let anyone forge tokens on an instance that never
# regenerated it.
APP_KEY=
APP_DEBUG=false
# Must be the public origin users reach the panel on, scheme included.
#
# This is not cosmetic: verification and password-reset mail is queued and sent
# by Horizon, i.e. from a CLI process with no request to infer the host from, so
# Laravel builds those links from APP_URL alone. Leaving the default makes every
# mailed link point at localhost.
APP_URL=http://localhost

LOG_CHANNEL=stack
# `debug` on a production instance writes per-request detail (including request
# payloads) to storage/logs, which is both a disclosure risk and a disk-filling
# one. Lower it to debug only while actively troubleshooting.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=txboard
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Set to true once the site is served over HTTPS so the session cookie is never
# sent over a plaintext connection.
SESSION_SECURE_COOKIE=false

# Comma-separated origins allowed to call the API from a browser.
#
# Leave this empty for the normal deployment, where the gateway serves both SPAs
# and the API from one origin: same-origin requests need no CORS entry at all,
# and an empty list means no third-party site can read API responses. Set it
# only when a frontend really is hosted elsewhere, e.g.
#   CORS_ALLOWED_ORIGINS=https://panel.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Optional regex patterns, for cases such as https://.*\.example\.com
CORS_ALLOWED_ORIGINS_PATTERNS=

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Must be a real address; the previous literal `null` made every send fail
# validation before it reached the transport.
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=TXBoard
MAILGUN_DOMAIN=
MAILGUN_SECRET=


# Prevent reinstallation
INSTALLED=false
# A process expectation only, never a switch for the persisted installation mode.
# Native preparation remains not ready until the complete C2 chain is delivered.
CORE_INSTALLATION_MODE=legacy
CORE_INSTALLATION_EPOCH=1
# Native Node Protocol v1 WS via the existing Workerman server.
# Requires the WS service and Upgrade reverse proxy to be reachable.
# Remains disabled until an authenticated staging handshake is verified.
TXBOARD_NATIVE_NODE_WS_ENABLED=false

# Optional finite Node authorization; enable only after provisioning explicit
# Node public pins and persistent Linux state. Use a dedicated Ed25519 seed,
# never APP_KEY, Node/Machine credentials or a Provider fixture key.
# Keep the private seed in the deployment secret store, not source or SQL.
NATIVE_NODE_AUTHORIZATION_ENABLED=false
NATIVE_NODE_AUTHORIZATION_CORE_INSTANCE_ID=
NATIVE_NODE_AUTHORIZATION_KEY_ID=
NATIVE_NODE_AUTHORIZATION_KEY_EPOCH=
NATIVE_NODE_AUTHORIZATION_PRIVATE_SEED=
NATIVE_NODE_AUTHORIZATION_LEASE_SECONDS=120
NATIVE_NODE_AUTHORIZATION_MAX_CLOCK_SKEW_SECONDS=5

# Optional real credential Provider control plane. Empty ID means unconfigured.
# These are Core service identity files, not proxy credential material.
# Registration does not activate native runtime or Node credential delivery.
CORE_CREDENTIAL_PROVIDER_ID=
CORE_CREDENTIAL_PROVIDER_ENDPOINT=
CORE_CREDENTIAL_PROVIDER_EPOCH=1
CORE_CREDENTIAL_PROVIDER_CA_FILE=
CORE_CREDENTIAL_PROVIDER_CERT_FILE=
CORE_CREDENTIAL_PROVIDER_KEY_FILE=
CORE_CREDENTIAL_PROVIDER_PROFILES=vless-uuid/v1,vmess-uuid/v1

# Copy to deploy/.env before the first `docker compose up`.
#
# docker compose reads this file automatically, so every value below is the
# single source of truth for the stack. The database credentials are *required*
# (compose fails loudly when they are missing) because silently defaulting a
# database password to a well-known value is a production hazard.

TXBOARD_DB_DATABASE=txboard
TXBOARD_DB_USERNAME=txboard
TXBOARD_DB_PASSWORD=
TXBOARD_DB_ROOT_PASSWORD=

# One published application image. Pin a sha-* tag for deterministic rollouts.
TXBOARD_IMAGE=ghcr.io/paimoncai/txboard:latest

# Host ports for the TXBoard gateway. Change them when 80/443 are already taken.
TXBOARD_HTTP_PORT=80
TXBOARD_HTTPS_PORT=443

# Public hostname, for automatic HTTPS.
#
#   unset (or an empty value)  -> plain HTTP on :80. Use this when TLS is
#                                 terminated in front of this stack, e.g. by
#                                 Cloudflare or an upstream load balancer.
#   panel.example.com          -> Caddy requests and renews a Let's Encrypt
#                                 certificate for that name and redirects :80
#                                 to :443. DNS must already resolve here, and
#                                 ports 80/443 must reach this machine, or the
#                                 ACME challenge fails and Caddy retries.
TXBOARD_SITE_ADDRESS=

# Optional raw Caddy TLS directive, inserted verbatim into the site block.
# Useful when public ACME cannot be used:
#   TXBOARD_TLS_DIRECTIVE=tls internal              private CA / self-signed
#   TXBOARD_TLS_DIRECTIVE=tls admin@example.com     pin the ACME account e-mail
TXBOARD_TLS_DIRECTIVE=

# Backups (deploy/backup.sh, run periodically by the `backup` service).
# TXBOARD_BACKUP_DIR must not be the same disk as the MySQL volume if you care
# about surviving disk failure.
TXBOARD_BACKUP_DIR=./backups
TXBOARD_BACKUP_INTERVAL=86400
TXBOARD_BACKUP_RETENTION=7

# The TXBoard image bundles its own Redis listening on a unix socket, which is what
# the defaults below point at. Override both to use an external Redis.
TXBOARD_REDIS_HOST=/data/redis.sock
TXBOARD_REDIS_PORT=0
TXBOARD_REDIS_PASSWORD=null

# Rendered by deploy/sync-gateway.sh from the panel setting "subscribe_path".
# The gateway inside the TXBoard image reads SUBSCRIBE_PATH, so a value that differs
# from the panel silently breaks every subscription link. Regenerate this file
# after changing the setting instead of editing it by hand.
TXBOARD_SUBSCRIBE_PATH=s

# Dependencies
**/node_modules/
**/vendor/

# Local environment and secrets
**/.env
**/.env.*
!**/.env.example

# Build and coverage output
**/dist/
**/build/
**/coverage/
**/.cache/
**/*.log

# Go and local binaries
**/*.exe
**/tx-node

# Backups written by backup.sh -- never commit a dump: it holds live user
# data, password hashes and the APP_KEY.
backups/

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

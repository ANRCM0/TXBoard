{
  "name": "txboard-gateway-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:gateway": "npm run dev --workspace @txboard/gateway",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "smoke:staging": "node scripts/smoke-gateway.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:core": "bash tests/integration/run-linux.sh",
    "test:browser": "node --test tests/browser/mock-gateway.test.mjs",
    "test:redis": "node --test tests/redis/redis-security.test.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "esbuild": "0.28.2"
  }
}

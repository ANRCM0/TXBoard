APP_NAME=XBoard
APP_ENV=production
# Intentionally empty. The container entrypoint generates one on first boot and
# persists it here (Docker); on bare metal run `php artisan key:generate`.
# Shipping a real key would let anyone forge tokens on an instance that never
# regenerated it.
APP_KEY=
APP_DEBUG=false
# Must be the public origin users reach the panel on, scheme included.
#
# This is not cosmetic: verification and password-reset mail is queued and sent
# by Horizon, i.e. from a CLI process with no request to infer the host from, so
# Laravel builds those links from APP_URL alone. Leaving the default makes every
# mailed link point at localhost.
APP_URL=http://localhost

LOG_CHANNEL=stack
# `debug` on a production instance writes per-request detail (including request
# payloads) to storage/logs, which is both a disclosure risk and a disk-filling
# one. Lower it to debug only while actively troubleshooting.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xboard
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Set to true once the site is served over HTTPS so the session cookie is never
# sent over a plaintext connection.
SESSION_SECURE_COOKIE=false

# Comma-separated origins allowed to call the API from a browser.
#
# Leave this empty for the normal deployment, where the gateway serves both SPAs
# and the API from one origin: same-origin requests need no CORS entry at all,
# and an empty list means no third-party site can read API responses. Set it
# only when a frontend really is hosted elsewhere, e.g.
#   CORS_ALLOWED_ORIGINS=https://panel.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Optional regex patterns, for cases such as https://.*\.example\.com
CORS_ALLOWED_ORIGINS_PATTERNS=

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Must be a real address; the previous literal `null` made every send fail
# validation before it reached the transport.
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=XBoard
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# google cloud storage
ENABLE_AUTO_BACKUP_AND_UPDATE=false
GOOGLE_CLOUD_KEY_FILE=config/googleCloudStorageKey.json
GOOGLE_CLOUD_STORAGE_BUCKET=

# Prevent reinstallation
INSTALLED=false
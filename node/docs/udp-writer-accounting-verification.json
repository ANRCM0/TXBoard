  "real_io_evidence": [
    "default and opt-in actual pinned CopyPacket deliver live and cached-plus-live loopback UDP exactly once",
    "failed raw closed UDP writer reports handshake failure with no counted attempted bytes",
    "successful UDP delivery occurs before callback limiter wait; tracked Close cancels that wait and preserves bytes",
    "plain generic writer unwrap retains pre-write wait and Close cancels it before delivery",
    "existing actual reader CopyPacket still increments legacy download for physical upload"
  ],
  "limitations": [
    "callback limiter is original post-write backpressure, not a pre-I/O rate or finite lease admission gate",
    "generic writer casting may forgo an upstream-specific shortcut while retaining direct writer accounting and limiter",
    "explicit manual Upstream access can bypass wrappers; no authorization fence is activated",
    "pinned sing can return nil for first-write failure without a handshake-failure reporter; error semantics unchanged",
    "callback timestamps prove completion only, no full I/O or remote Terms interval",
    "all optional event evidence is unattributable and volatile including sealed buckets; no durable consumer or ActiveCount-based completion"
  ],

{
  "format": 2,
  "name": "my-theme",
  "title": "My Theme",
  "version": "1.0.0",
  "entry": {
    "type": "spa",
    "module": "dist/index.js"
  },
  "engines": {
    "txboard": ">=3.6",
    "gateway": ">=1 <2",
    "contract": "1.x"
  },
  "gateway": {
    "contract": "1.x",
    "sdk": {
      "package": "@ANRCM0/theme-sdk",
      "version": ">=0.1.0 <1.0.0"
    },
    "capabilities": [
      "bootstrap",
      "theme.config",
      "plans",
      "auth.login",
      "orders.create"
    ]
  },
  "build": {
    "tool": "vite@6",
    "node": ">=22"
  },
  "assets": [
    { "path": "dist/index.css", "integrity": "sha256-<base64-from-sha256-of-built-css>" }
  ],
  "config": {
    "schema": "theme.config.schema.json",
    "defaults": {
      "primaryColor": "#0f766e"
    },
    "public": ["primaryColor"]
  },
  "dependencies": {
    "runtime": []
  },
  "security": {
    "csp": "strict",
    "remoteCode": false
  },
  "author": {
    "name": "my-theme author",
    "license": "MIT"
  }
}

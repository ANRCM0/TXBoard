{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:txboard:theme-package:v2",
  "title": "TXBoard static SPA theme package",
  "type": "object",
  "properties": {
    "format": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "title": {},
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "object",
      "properties": {
        "type": {
          "const": "spa"
        },
        "module": {
          "type": "string",
          "pattern": "^dist/[A-Za-z0-9._/-]+\\.m?js$"
        }
      },
      "required": [
        "type",
        "module"
      ],
      "additionalProperties": false
    },
    "engines": {
      "type": "object",
      "properties": {
        "txboard": {
          "type": "string",
          "minLength": 1
        },
        "gateway": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "const": "1.x"
        }
      },
      "required": [
        "txboard",
        "gateway",
        "contract"
      ],
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "1.x"
        },
        "sdk": {
          "type": "object",
          "properties": {
            "package": {
              "const": "@txboard/theme-sdk"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "package",
            "version"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,79}$"
          }
        }
      },
      "required": [
        "contract",
        "sdk",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(dist|assets)/[A-Za-z0-9._/-]+$"
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
          }
        },
        "required": [
          "path",
          "integrity"
        ],
        "additionalProperties": false
      }
    },
    "build": {},
    "config": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "theme.config.schema.json"
        },
        "defaults": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "public": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "runtime": {
          "const": []
        }
      },
      "required": [
        "runtime"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "csp": {
          "const": "strict"
        },
        "remoteCode": {
          "const": false
        },
        "tokenStorage": {
          "type": "string"
        }
      },
      "required": [
        "csp",
        "remoteCode"
      ],
      "additionalProperties": false
    },
    "author": {}
  },
  "required": [
    "format",
    "name",
    "version",
    "entry",
    "engines",
    "gateway",
    "assets",
    "dependencies",
    "security"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:txboard:module-package:v1",
  "title": "TXBoard Module Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "compatibility", "capabilities"],
  "properties": {
    "schema": {
      "const": 1
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "type": {
          "enum": ["core", "plugin", "theme", "integration", "provider", "agent"]
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "author": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["txboard"],
      "properties": {
        "txboard": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "admin.menu",
          "admin.settings",
          "admin.crud",
          "admin.app",
          "api.route",
          "web.route",
          "hook.action",
          "hook.filter",
          "database.migration",
          "scheduler",
          "command",
          "theme",
          "payment.provider",
          "notification.provider",
          "agent.api",
          "agent.admin"
        ]
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "minLength": 2,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "path"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
              },
              "icon": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "order": {
                "type": "integer",
                "minimum": -100000,
                "maximum": 100000
              }
            }
          }
        }
      }
    }
  }
}
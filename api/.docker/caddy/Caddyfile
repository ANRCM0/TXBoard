{
	admin off
	persist_config off
	log {
		output stdout
		format console
	}
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

# One public listener for the complete TXBoard control plane.
#
# TXBOARD_SITE_ADDRESS unset/:80 -> plain HTTP (usually behind Cloudflare/nginx)
# TXBOARD_SITE_ADDRESS=panel.example.com -> automatic HTTPS on 443.
{$TXBOARD_SITE_ADDRESS::80} {
	encode zstd gzip

	{$TXBOARD_TLS_DIRECTIVE}

	@ws path /ws
	handle @ws {
		reverse_proxy 127.0.0.1:{$WS_PORT:8076}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$OCTANE_INTERNAL_PORT:7002} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /plugin/* {
		reverse_proxy 127.0.0.1:{$OCTANE_INTERNAL_PORT:7002} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /storage/* {
		reverse_proxy 127.0.0.1:{$OCTANE_INTERNAL_PORT:7002} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Plugin Package v1 admin bundles are published to /www/public/plugins.
	# Keep this route separate from the singular /plugin/* backend API namespace.
	handle_path /plugins/* {
		root * /www/public/plugins
		file_server
	}

	@subscribe path /{$SUBSCRIBE_PATH:s}/*
	handle @subscribe {
		reverse_proxy 127.0.0.1:{$OCTANE_INTERNAL_PORT:7002} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	redir /admin /admin/

	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/user
		try_files {path} /index.html
		file_server
	}
}

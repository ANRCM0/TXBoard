{
  "schema": "native-admin-settings/v1",
  "fields": {
    "app_name": {
      "group": "site",
      "label": "站点名称",
      "setting": "app_name",
      "kind": "text",
      "default": "TXBoard",
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "write_only": false
    },
    "app_description": {
      "group": "site",
      "label": "站点描述",
      "setting": "app_description",
      "kind": "text",
      "default": "TXBoard control plane",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "app_url": {
      "group": "site",
      "label": "站点地址",
      "setting": "app_url",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "logo": {
      "group": "site",
      "label": "标志地址",
      "setting": "logo",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "tos_url": {
      "group": "site",
      "label": "服务条款地址",
      "setting": "tos_url",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "stop_register": {
      "group": "site",
      "label": "关闭新用户注册",
      "setting": "stop_register",
      "kind": "checkbox",
      "default": false,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "invite_enable": {
      "group": "features",
      "label": "邀请",
      "setting": "invite_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "gift_card_enable": {
      "group": "features",
      "label": "礼品卡",
      "setting": "gift_card_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "ticket_enable": {
      "group": "features",
      "label": "工单",
      "setting": "ticket_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "knowledge_enable": {
      "group": "features",
      "label": "知识库",
      "setting": "knowledge_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "traffic_log_enable": {
      "group": "features",
      "label": "流量记录",
      "setting": "traffic_log_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "announcement_enable": {
      "group": "features",
      "label": "公告",
      "setting": "announcement_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "register_enable": {
      "group": "features",
      "label": "注册入口",
      "setting": "register_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "email_verify": {
      "group": "safe",
      "label": "注册验证邮箱",
      "setting": "email_verify",
      "kind": "checkbox",
      "default": false,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "email_whitelist_enable": {
      "group": "safe",
      "label": "启用邮箱后缀白名单",
      "setting": "email_whitelist_enable",
      "kind": "checkbox",
      "default": false,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "email_gmail_limit_enable": {
      "group": "safe",
      "label": "限制 Gmail 别名",
      "setting": "email_gmail_limit_enable",
      "kind": "checkbox",
      "default": false,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "captcha_enable": {
      "group": "safe",
      "label": "启用验证码",
      "setting": "captcha_enable",
      "kind": "checkbox",
      "default": false,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "register_limit_by_ip_enable": {
      "group": "safe",
      "label": "限制同 IP 注册",
      "setting": "register_limit_by_ip_enable",
      "kind": "checkbox",
      "default": false,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "email_whitelist_suffix": {
      "group": "safe",
      "label": "邮箱后缀白名单",
      "setting": "email_whitelist_suffix",
      "kind": "list",
      "default": [],
      "schema": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "maxItems": 100
      },
      "write_only": false
    },
    "captcha_type": {
      "group": "safe",
      "label": "验证码服务",
      "setting": "captcha_type",
      "kind": "select",
      "default": "recaptcha",
      "schema": {
        "type": "string",
        "enum": [
          "recaptcha",
          "turnstile",
          "recaptcha-v3"
        ]
      },
      "write_only": false,
      "options": [
        "recaptcha",
        "turnstile",
        "recaptcha-v3"
      ]
    },
    "recaptcha_site_key": {
      "group": "safe",
      "label": "reCAPTCHA Site Key",
      "setting": "recaptcha_site_key",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 8192
      },
      "write_only": false
    },
    "recaptcha_v3_site_key": {
      "group": "safe",
      "label": "reCAPTCHA v3 Site Key",
      "setting": "recaptcha_v3_site_key",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 8192
      },
      "write_only": false
    },
    "turnstile_site_key": {
      "group": "safe",
      "label": "Turnstile Site Key",
      "setting": "turnstile_site_key",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 8192
      },
      "write_only": false
    },
    "recaptcha_key": {
      "group": "safe",
      "label": "reCAPTCHA 密钥",
      "setting": "recaptcha_key",
      "kind": "password",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 8192
      },
      "write_only": true
    },
    "recaptcha_v3_secret_key": {
      "group": "safe",
      "label": "reCAPTCHA v3 密钥",
      "setting": "recaptcha_v3_secret_key",
      "kind": "password",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 8192
      },
      "write_only": true
    },
    "turnstile_secret_key": {
      "group": "safe",
      "label": "Turnstile 密钥",
      "setting": "turnstile_secret_key",
      "kind": "password",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 8192
      },
      "write_only": true
    },
    "login_limit_enabled": {
      "group": "safe",
      "label": "限制登录尝试",
      "setting": "password_limit_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "login_limit_count": {
      "group": "safe",
      "label": "允许登录尝试次数",
      "setting": "password_limit_count",
      "kind": "number",
      "default": 5,
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "write_only": false
    },
    "login_limit_expire": {
      "group": "safe",
      "label": "登录限制时间（分钟）",
      "setting": "password_limit_expire",
      "kind": "number",
      "default": 60,
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "write_only": false
    },
    "register_limit_count": {
      "group": "safe",
      "label": "允许注册次数",
      "setting": "register_limit_count",
      "kind": "number",
      "default": 3,
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "write_only": false
    },
    "register_limit_expire": {
      "group": "safe",
      "label": "注册限制时间（分钟）",
      "setting": "register_limit_expire",
      "kind": "number",
      "default": 60,
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "write_only": false
    },
    "plan_change_enable": {
      "group": "subscribe",
      "label": "允许更换套餐",
      "setting": "plan_change_enable",
      "kind": "checkbox",
      "default": true,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "reset_traffic_method": {
      "group": "subscribe",
      "label": "新发布套餐的默认重置方式",
      "setting": "reset_traffic_method",
      "kind": "number",
      "default": 1,
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      },
      "write_only": false
    },
    "new_order_event_id": {
      "group": "subscribe",
      "label": "新购时应用权益",
      "setting": "new_order_event_id",
      "kind": "number",
      "default": 0,
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "write_only": false
    },
    "renew_order_event_id": {
      "group": "subscribe",
      "label": "续费时应用权益",
      "setting": "renew_order_event_id",
      "kind": "number",
      "default": 0,
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "write_only": false
    },
    "change_order_event_id": {
      "group": "subscribe",
      "label": "换套餐时应用权益",
      "setting": "change_order_event_id",
      "kind": "number",
      "default": 0,
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "write_only": false
    },
    "server_pull_interval": {
      "group": "server",
      "label": "节点拉取间隔（秒）",
      "setting": "server_pull_interval",
      "kind": "number",
      "default": 60,
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400
      },
      "write_only": false
    },
    "server_push_interval": {
      "group": "server",
      "label": "节点上报间隔（秒）",
      "setting": "server_push_interval",
      "kind": "number",
      "default": 60,
      "schema": {
        "type": "integer",
        "minimum": 1,
        "maximum": 86400
      },
      "write_only": false
    },
    "device_limit_mode": {
      "group": "server",
      "label": "设备限制模式",
      "setting": "device_limit_mode",
      "kind": "number",
      "default": 0,
      "schema": {
        "type": "integer",
        "minimum": 0,
        "maximum": 86400
      },
      "write_only": false
    },
    "email_host": {
      "group": "email",
      "label": "SMTP 主机",
      "setting": "email_host",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 255
      },
      "write_only": false
    },
    "email_port": {
      "group": "email",
      "label": "SMTP 端口",
      "setting": "email_port",
      "kind": "text",
      "default": "465",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 255
      },
      "write_only": false
    },
    "email_username": {
      "group": "email",
      "label": "SMTP 用户名",
      "setting": "email_username",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 255
      },
      "write_only": false
    },
    "email_from_address": {
      "group": "email",
      "label": "发件人地址",
      "setting": "email_from_address",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 255
      },
      "write_only": false
    },
    "email_encryption": {
      "group": "email",
      "label": "SMTP 加密",
      "setting": "email_encryption",
      "kind": "select",
      "default": "ssl",
      "schema": {
        "type": "string",
        "enum": [
          "ssl",
          "tls",
          ""
        ]
      },
      "write_only": false,
      "options": [
        "ssl",
        "tls",
        ""
      ]
    },
    "email_password": {
      "group": "email",
      "label": "SMTP 密码",
      "setting": "email_password",
      "kind": "password",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 8192
      },
      "write_only": true
    },
    "telegram_bot_enable": {
      "group": "telegram",
      "label": "启用 Telegram 机器人",
      "setting": "telegram_bot_enable",
      "kind": "checkbox",
      "default": false,
      "schema": {
        "type": "boolean"
      },
      "write_only": false
    },
    "telegram_bot_token": {
      "group": "telegram",
      "label": "机器人 Token",
      "setting": "telegram_bot_token",
      "kind": "password",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 256
      },
      "write_only": true
    },
    "telegram_webhook_url": {
      "group": "telegram",
      "label": "Webhook 站点地址",
      "setting": "telegram_webhook_url",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "telegram_discuss_link": {
      "group": "telegram",
      "label": "讨论群链接",
      "setting": "telegram_discuss_link",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "windows_version": {
      "group": "app",
      "label": "Windows 版本",
      "setting": "windows_version",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 120
      },
      "write_only": false
    },
    "windows_download_url": {
      "group": "app",
      "label": "Windows 下载地址",
      "setting": "windows_download_url",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "macos_version": {
      "group": "app",
      "label": "macOS 版本",
      "setting": "macos_version",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 120
      },
      "write_only": false
    },
    "macos_download_url": {
      "group": "app",
      "label": "macOS 下载地址",
      "setting": "macos_download_url",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "android_version": {
      "group": "app",
      "label": "Android 版本",
      "setting": "android_version",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 120
      },
      "write_only": false
    },
    "android_download_url": {
      "group": "app",
      "label": "Android 下载地址",
      "setting": "android_download_url",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "write_only": false
    },
    "admin_sidebar_style": {
      "group": "appearance",
      "label": "侧栏表面风格",
      "setting": "admin_sidebar_style",
      "kind": "select",
      "default": "normal",
      "schema": {
        "type": "string",
        "enum": [
          "normal",
          "contrast"
        ]
      },
      "options": [
        "normal",
        "contrast"
      ],
      "write_only": false
    },
    "admin_header_style": {
      "group": "appearance",
      "label": "页面标题区风格",
      "setting": "admin_header_style",
      "kind": "select",
      "default": "normal",
      "schema": {
        "type": "string",
        "enum": [
          "normal",
          "accent"
        ]
      },
      "options": [
        "normal",
        "accent"
      ],
      "write_only": false
    },
    "admin_color_scheme": {
      "group": "appearance",
      "label": "强调色",
      "setting": "admin_color_scheme",
      "kind": "select",
      "default": "default",
      "schema": {
        "type": "string",
        "enum": [
          "default",
          "black",
          "blackblue",
          "green"
        ]
      },
      "options": [
        "default",
        "black",
        "blackblue",
        "green"
      ],
      "write_only": false
    },
    "admin_login_background_url": {
      "group": "appearance",
      "label": "登录背景地址",
      "setting": "admin_login_background_url",
      "kind": "text",
      "default": "",
      "schema": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048,
        "pattern": "^(?:$|https://[^\\s\\\\]+|/(?!/)[^\\s\\\\]*)$"
      },
      "write_only": false
    }
  }
}
